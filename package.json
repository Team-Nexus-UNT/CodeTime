{
  "name": "codetime",
  "displayName": "CodeTime",
  "publisher": "codetime-dev",
  "version": "0.0.1",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Other"],
  "main": "./extension.js",

  "activationEvents": [
    "onCommand:codetime.uploadAudio",
    "onCommand:codetime.uploadVideo",
    "onCommand:codetime.recordVideo",
    "onCommand:codetime.test",
    "onCommand:codetime.openInstructorMode",
    "onCommand:codetime.addAnnotation",
    "onCommand:codetime.createWalkthrough",
    "onCommand:codetime.addWalkthroughStep",
    "onCommand:codetime.playWalkthrough",
    "onView:codetime.walkthroughView"
  ],

  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "codetime", "title": "CodeTime", "icon": "media/codetime.png" }
      ]
    },
    "views": {
      "codetime": [
        { "id": "codetime.timelineView", "name": "Timeline", "type": "webview", "icon": "media/codetime.png" },
        { "id": "codetime.instructorMode", "name": "Instructor Mode", "type": "webview", "icon": "media/codetime.png" },
        { "id": "codetime.walkthroughView", "name": "Walkthroughs", "type": "webview", "icon": "media/codetime.png" }
      ]
    },
    "commands": [
      {
        "command": "codetime.uploadAudio",
        "title": "CodeTime: Upload Audio Clip",
        "category": "CodeTime"
      },
      {
        "command": "codetime.uploadVideo",
        "title": "CodeTime: Upload Video",
        "category": "CodeTime"
      },
      {
        "command": "codetime.recordVideo",
        "title": "CodeTime: Record Video (legacy alias)",
        "category": "CodeTime"
      },
      { "command": "codetime.openInstructorMode", "title": "CodeTime: Open Instructor Mode" },
      { "command": "codetime.addAnnotation", "title": "CodeTime: Add Annotation" },
      { "command": "codetime.createWalkthrough", "title": "CodeTime: Create Walkthrough" },
      { "command": "codetime.addWalkthroughStep", "title": "CodeTime: Add Step to Walkthrough" },
      { "command": "codetime.playWalkthrough", "title": "CodeTime: Play Walkthrough" },
      { "command": "codetime.test", "title": "CodeTime: Test Activation", "category": "CodeTime" }
    ]
  }
}
