{
  "name": "codetime",
  "displayName": "CodeTime",
  "publisher": "codetime-dev",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onCommand:codetime.test",
    "onCommand:codetime.openTimeline",
    "onView:codetime.timelineView",
    "onCommand:codetime.createWalkthrough",
    "onCommand:codetime.addWalkthroughStep",
    "onCommand:codetime.playWalkthrough"
    "onView:codetime.instructorMode",
    "onCommand:codetime.openInstructorMode",
    "onCommand:codetime.uploadAudio",
    "onCommand:codetime.addAnnotation"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codetime",
          "title": "CodeTime",
          "icon": "media/codetime.png"
        }
      ]
    },
    "views": {
      "codetime": [
        {
          "id": "codetime.timelineView",
          "name": "Timeline",
          "icon": "media/codetime.png"
        }
      ]
    },
    "commands": [
      {
        "command": "codetime.test",
        "title": "CodeTime: Test Activation"
      },
      {
        "command": "codetime.openTimeline",
        "title": "CodeTime: Open Timeline"
      },
      {
        "command": "codetime.createWalkthrough",
        "title": "CodeTime: Create Walkthrough"
      },
      {
        "command": "codetime.addWalkthroughStep",
        "title": "CodeTime: Add Step to Walkthrough"
      },
      {
        "command": "codetime.playWalkthrough",
        "title": "CodeTime: Play Walkthrough"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codetime.uploadAudio",
          "when": "view == codetime.instructorMode",
          "group": "navigation@1"
        }
      ]
    }
  }
}